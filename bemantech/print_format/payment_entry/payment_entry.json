 "html": "<div class=\"print-format\">\r\n\r\n    <!-- ================= COMPANY HEADER ================= -->\r\n    <div class=\"print-heading\">\r\n        <h2>{{ doc.company }}</h2>\r\n        <small>\r\n            {% set company = frappe.get_doc(\"Company\", doc.company) %}\r\n            {{ company.company_name }}\r\n            {% if company.phone_no %}<br>Phone: {{ company.phone_no }}{% endif %}\r\n        </small>\r\n    </div>\r\n\r\n    <div class=\"title\">PAYMENT RECEIPT</div>\r\n\r\n    <!-- ================= PAYMENT INFO ================= -->\r\n    <table class=\"no-border\">\r\n        <tr>\r\n            <td><b>Receipt No:</b> {{ doc.name }}</td>\r\n            <td class=\"text-right\"><b>Date:</b> {{ doc.posting_date }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td><b>Payment Mode:</b> {{ doc.mode_of_payment }}</td>\r\n            <td class=\"text-right\"><b>Status:</b> {{ doc.status }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ================= CUSTOMER INFO ================= -->\r\n    <div class=\"section-title\">Customer Information</div>\r\n    <table>\r\n        <tr>\r\n            <td><b>Customer ID</b></td>\r\n            <td>{{ doc.party }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td><b>Customer Name</b></td>\r\n            <td>{{ doc.custom_customer_id }}</td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ================= PAYMENT SUMMARY ================= -->\r\n    <div class=\"section-title\">Payment Summary</div>\r\n\r\n    {% set remaining_due = doc.total_allocated_amount + doc.unallocated_amount %}\r\n    {% set total_due_before = remaining_due + doc.paid_amount %}\r\n\r\n    <table>\r\n        <tr>\r\n            <th>Description</th>\r\n            <th class=\"text-right\">Amount (BDT)</th>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td>Total Customer Due (Before Payment)</td>\r\n            <td class=\"text-right\">{{ doc.custom_total_outstanding }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td>Paid Amount</td>\r\n            <td class=\"text-right\">{{ doc.paid_amount }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td>Tax & Charges</td>\r\n            <td class=\"text-right\">{{ doc.total_taxes_and_charges }}</td>\r\n        </tr>\r\n\r\n        <tr class=\"grand-total\">\r\n            <td>Net Received</td>\r\n            <td class=\"text-right\">{{ doc.received_amount }}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td><b>Remaining Due</b></td>\r\n            <td class=\"text-right\"><b>{{ remaining_due }}</b></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ================= REMARKS ================= -->\r\n    <div class=\"remarks\">\r\n        <b>Remarks:</b> {{ doc.remarks }}\r\n    </div>\r\n\r\n    <!-- ================= AMOUNT IN WORDS ================= -->\r\n    <div class=\"amount-words\">\r\n        <b>Amount in Words:</b> {{ doc.base_in_words }}\r\n    </div>\r\n\r\n    <!-- ================= SIGNATURE ================= -->\r\n    <div class=\"signature-box\">\r\n        <div class=\"signature\">Received By</div>\r\n        <div class=\"signature\">Authorized Signature</div>\r\n    </div>\r\n\r\n    <!-- ================= FOOTER ================= -->\r\n    <div class=\"print-footer\">\r\n        This is a system generated receipt | Powered by Frappe ERPNext\r\n    </div>\r\n\r\n</div>\r\n",
